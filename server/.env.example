# Salin ke .env dan sesuaikan. JANGAN commit berkas .env yang berisi rahasia.
FMN_ENV=dev
FMN_ADDR=:8080

# DSN dibiarkan tanpa password; isi PGPASSWORD di shell, bukan di berkas ini.
FMN_DATABASE_URL=postgres://postgres@localhost:5432/fmn_dev?sslmode=disable

# Wajib diisi saat FMN_ENV bukan dev.
FMN_JWT_SECRET=

FMN_ALLOWED_ORIGINS=http://localhost:5173
FMN_ACCESS_TTL_MIN=15
FMN_REFRESH_TTL_DAY=14
FMN_MAX_BODY_BYTES=1048576
